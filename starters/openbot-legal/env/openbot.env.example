# Lines to set in OpenBot's .env (copied from .env.example), for the Open Harvey on OpenBot starter.
# Everything not listed here keeps its .env.example value.
#
# OpenBot reads .env only when the API server boots, and `bash scripts/start.sh` keeps a server that is
# already running. After changing a line here once OpenBot is up, restart it fully:
#   bash scripts/stop.sh && bash scripts/start.sh

# The tenant package: the Contract Copilot, its three skills and the Contract Review channel.
# Relative to server/, like the shipped default (../examples/fintech).
TENANT_PACKAGE_DIR=../examples/northstar-legal

# Model key. model.yaml uses OpenAI; see that file to switch to Anthropic.
OPENAI_API_KEY=sk-REPLACE_ME

# CopilotKit Intelligence. OpenBot keeps every thread there, so nothing runs without the runtime key.
# `npx --yes copilotkit@latest project select` writes the key, and `bun scripts/setup-learning.ts`
# the Learning container, after `npx --yes copilotkit@latest login`. Managed Intelligence needs no
# COPILOTKIT_LICENSE_TOKEN. (INTELLIGENCE_API_KEY is OpenBot's legacy name for the same key;
# CPK_INTELLIGENCE_API_KEY wins when both are set.)
# CPK_INTELLIGENCE_API_KEY=cpk-written-by-project-select
# CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=openbot

# Already true in .env.example: you are the one administrator on localhost, which connect.ts relies
# on. Right for a laptop; turn it off anywhere other people can reach.
OPENBOT_SINGLE_USER=true

# Northstar Legal itself reads no line from this file. Its settings are environment variables on its
# own commands (see the README):
#   NORTHSTAR_LEGAL_PORT   server.ts port, default 4320
#   NORTHSTAR_LEGAL_TOKEN  bearer token, if you hold it yourself; otherwise server.ts creates one in
#                          examples/northstar-legal/legal-system/.env.northstar-legal and reuses it
#   NORTHSTAR_LEGAL_URL    connect.ts: the tunnel's https address, ending in /mcp
#   OPENBOT_API_URL        connect.ts: OpenBot's API, default http://localhost:3001

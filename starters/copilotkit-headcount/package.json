{
  "name": "copilotkit-headcount",
  "version": "0.1.0",
  "private": true,
  "description": "Workshop starter: a functional copilot for headcount approvals, built with CopilotKit and AG-UI.",
  "scripts": {
    "dev": "next dev -p 3100 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3100 -H 127.0.0.1",

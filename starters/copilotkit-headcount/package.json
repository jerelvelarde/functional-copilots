    "typecheck": "tsc --noEmit",
    "sync-data": "cp ../shared-data/company.json ../shared-data/headcount-plan.json ../shared-data/comp-bands.json ../shared-data/policies.md ../shared-data/approval-history.jsonl src/data/"

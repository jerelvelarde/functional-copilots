# Lines for OpenTag's .env, when OpenBot is its agent. Add them to OpenTag/.env rather than copying this
# file over it, so nothing the CopilotKit CLI wrote there is lost. Use OpenTag's `openbot-pairing`
# branch (draft PR #92): its main branch does not send the `openbot.sender` context, and OpenBot
# refuses every turn without it.
#
# Slack's bot token (xoxb-...) and signing secret do NOT go here, or in OpenBot. They are attached to
# the managed Channel in CopilotKit Intelligence by `npx copilotkit@latest channels add ...`.

# OpenBot's OpenTag endpoint. The OpenTag runtime connects out to Intelligence, so on one laptop
# this can be localhost.
AGENT_URL=http://localhost:3001/api/delivery/webhooks/opentag/agent
AGENT_AUTH_HEADER="Bearer REPLACE_WITH_OPENBOT_OPENTAG_SHARED_SECRET"
OPENBOT_PAIRING=true

# The cpk- runtime key of the Intelligence project that owns the Channel (OpenTag reads it under this
# name), and the Channel's name exactly as given to `channels add --name`.
INTELLIGENCE_API_KEY=cpk-REPLACE_ME
INTELLIGENCE_CHANNEL_NAME=northstar-hana

# What Slack shows as the app's name in OpenTag's own messages.
AGENT_DISPLAY_NAME=Hana

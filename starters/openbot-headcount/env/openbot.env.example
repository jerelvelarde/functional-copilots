# Lines to set in OpenBot's .env (copied from .env.example), for the Northstar starter.
# Everything not listed here keeps its .env.example value.
#
# OpenBot reads .env only when the API server boots, and `bash scripts/start.sh` keeps a server that is
# already running. After changing a line here once OpenBot is up, restart it fully:
#   bash scripts/stop.sh && bash scripts/start.sh

# The tenant package. Relative to server/, like the shipped default.
TENANT_PACKAGE_DIR=../examples/northstar

# Model key. model.yaml uses OpenAI; see that file to switch to Anthropic.
OPENAI_API_KEY=sk-REPLACE_ME

# CopilotKit Intelligence. `npx --yes copilotkit@latest project select` writes the runtime key, and
# `bun scripts/setup-learning.ts` the Learning container, after `npx --yes copilotkit@latest login`.
# Managed Intelligence needs no COPILOTKIT_LICENSE_TOKEN. (INTELLIGENCE_API_KEY is OpenBot's legacy
# name for the same key; CPK_INTELLIGENCE_API_KEY wins when both are set.)
# CPK_INTELLIGENCE_API_KEY=cpk-written-by-project-select
# CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=openbot

# Slack and Microsoft Teams, through OpenTag (optional). At least 32 characters; the same value goes
# into OpenTag's AGENT_AUTH_HEADER as "Bearer <secret>". Generate with: openssl rand -hex 32
# OpenBot adds its OpenTag endpoint only if this is set when the server boots: restart fully after
# adding it (bash scripts/stop.sh && bash scripts/start.sh).
# OPENTAG_SHARED_SECRET=<output of: openssl rand -hex 32>
# OpenTag's base URL, for messages OpenBot sends when no Slack turn is open (the reply after an
# approval, among others). OpenTag's pairing branch does not implement that endpoint yet, so those
# sends fail and show as failed in Settings -> Notifications. Leave it unset until it does.
# OPENTAG_URL=https://opentag.example.com

# Optional: the CopilotKit web app's agent as a second coworker (see agents.yaml).
# HEADCOUNT_WEB_AGENT_URL=http://localhost:8000/agent
# AGENT_ENDPOINT_ALLOWED_HOSTS=localhost:8000
